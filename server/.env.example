# BACKEND ENVIRONMENT VARIABLES (EXAMPLE FILE)
# Copy this file to .env and replace the placeholders with actual values
PORT=4000
JWT_SECRET=HandiPlugSuperSecretKey_2026!SecureAuth#91
CLIENT_ORIGIN=http://localhost:5173
# Supabase Credentials
# IMPORTANT: Use your "service_role" secret key here, NOT the "anon" public key.
# Go to Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Transactional email (required in production; local development logs OTPs
# to the server terminal when these values are omitted)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=HandiPlug
NODE_ENV=development
